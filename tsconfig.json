{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "#lib": [
        "./src/lib/index.ts"
      ],
      "#lib/*": [
        "./src/lib/*"
      ]
    },
    "types": [
      "./worker-configuration.d.ts",
      "$app/types"
    ]
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
